DATABASE_URL=postgres://ies:ies@localhost:5432/ies
AUTH_SECRET=replace-with-a-random-string
APP_BASE_URL=http://localhost:3000

# Used only by npm run db:setup and npm run db:reset.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin1234!

# Password reset link lifetime in minutes.
RESET_TOKEN_TTL_MINUTES=60

# Leave SMTP unset in development. Messages are stored for /dev/emails.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
